{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-aware-assessment-catalogue",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  }
}
